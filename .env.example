# RunPod Discord invite shown on page 1.
# If unset the button renders disabled and the app logs a warning at startup.
DISCORD_INVITE_URL=https://discord.gg/runpod

# Code posted in the RunPod Discord channel, at most 64 characters. Typing it on page 1
# is one half of a raffle entry and a Discord username is the other. It never blocks a
# credit. Leave it empty and the check is off: the field still shows, any code counts,
# and the app logs a warning at startup. Never commit the real code to this repository.
JOIN_CODE=

# Bearer token for every /admin route, and for the detailed /health body.
# If unset the whole admin surface returns 503.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Directory holding signup.db and secret.key. Mount a volume here.
DATA_DIR=/data

# Key that signs the session cookie. Optional.
# If unset the app generates one on first start and keeps it in DATA_DIR/secret.key.
# SECRET_KEY=

# Handout controls. See the README for how the defaults were chosen.
# Most links one truncated client address may take per hour. Sized for a room.
CLAIM_RATE_LIMIT_PER_HOUR=120
# Most links the whole site may hand out per hour. The backstop.
GLOBAL_CLAIM_LIMIT_PER_HOUR=150
# Set to closed to pause handouts. Entries and the raffle keep working.
CLAIMS_OPEN=open
