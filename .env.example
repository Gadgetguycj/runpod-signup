# RunPod Discord invite shown on page 1.
# If unset the button renders disabled and the app logs a warning at startup.
DISCORD_INVITE_URL=https://discord.gg/runpod

# Bearer token for every /admin route. If unset the whole admin surface returns 503.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Directory holding signup.db. Mount a volume here.
DATA_DIR=/data
